!
hostname Bell_Router_01
!
! Enable password and user accounts
enable secret admin123
username admin privilege 15 secret admin123
!
ip cef
!
interface ethernet0/1
 description Link to Google_PE01
 ip address 172.16.2.1 255.255.255.252
 no shutdown
!
interface ethernet0/2
 description Link to Cloudflare_PE01
 ip address 198.51.100.6 255.255.255.252
 no shutdown
!
interface ethernet1/0
 description Link to ISP_ROUTER
 ip address 198.51.100.13 255.255.255.252
 no shutdown
!
interface ethernet0/0
 description Management Interface
 ip address {{ mgmt_ips['Bell_Router_01'] }} 255.255.255.0
 no shutdown
!
router bgp {{ bell_asn }}
 bgp log-neighbor-changes
 neighbor 172.16.2.2 remote-as {{ google_asn }}
 neighbor 172.16.2.2 description Google_PE01
 neighbor 198.51.100.5 remote-as {{ cloudflare_asn }}
 neighbor 198.51.100.5 description Cloudflare_PE01
 neighbor 198.51.100.14 remote-as {{ isp_router_asn }}
 neighbor 198.51.100.14 description ISP_ROUTER
 !
 address-family ipv4
  neighbor 172.16.2.2 activate
  neighbor 198.51.100.5 activate
  neighbor 198.51.100.14 activate
 exit-address-family
!
! Management access control
access-list 1 permit 192.168.16.0 0.0.0.255
access-list 1 deny any log
!
! VTY line configuration
line vty 0 15
 login local
 transport input ssh
 access-class 1 in
 exec-timeout 30 0
 logging synchronous
!
! Console line configuration
line console 0
 login local
 exec-timeout 30 0
 logging synchronous
!
! SSH configuration
ip ssh version 2
ip domain-name lab.local
crypto key generate rsa modulus 1024
!
end