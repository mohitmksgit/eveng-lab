!
hostname London_Router_01
!
ip cef
!
interface Loopback0
 description London Office
 ip address 10.40.0.1 255.255.255.255
!
interface ethernet0/1
 description London LAN
 ip address 10.40.0.254 255.255.255.0
 no shutdown
!
interface ethernet0/2
 description MPLS Link to MPLS01
 ip address 172.16.10.1 255.255.255.252
 no shutdown
!
interface ethernet0/0
 description Management Interface
 ip address {{ mgmt_ips['London_Router_01'] }} 255.255.255.0
 no shutdown
!
router bgp {{ london_asn }}
 bgp log-neighbor-changes
 neighbor 172.16.10.2 remote-as {{ mpls_asn }}
 neighbor 172.16.10.2 description MPLS01
 !
 address-family ipv4
  network 10.40.0.0 mask 255.255.255.0
  neighbor 172.16.10.2 activate
 exit-address-family
!
ip route 10.100.0.0 255.255.0.0 172.16.10.2
!
access-list 1 permit 192.168.16.0 0.0.0.255
!
line vty 0 4
 access-class 1 in
 transport input ssh
!
ip ssh version 2
!
end